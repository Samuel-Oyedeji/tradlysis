# =============================================================================
# Tradlysis server configuration. Copy to .env and fill in. Never commit .env.
#
# Only bootstrap values live here. Everything else (Capital.com credentials, OpenRouter key,
# Telegram, news feeds and every experiment with its risk limits) is edited in the dashboard
# on the Config page (/config) and stored in the database.
#
# Upgrading from an older .env? Leave your old variables in place for the first start: the
# engine/API copy them into the database once (the first experiment is created from
# EXPERIMENT_NAME, INSTRUMENT and the risk settings). After that you can delete them; values
# saved on the Config page win over anything still in this file.
#
# Check your setup at any time with:  python -m app.doctor   (or: docker compose run --rm engine python -m app.doctor)
# =============================================================================

# --- Database (REQUIRED) --------------------------------------------------------
# Used by Prisma (migrations) and the Python engine.
# Supabase: dashboard -> Connect -> "Session pooler" URI (port 5432), with your DB password filled in
# (URL-encode special characters, e.g. @ -> %40). Not the Supabase API URL/keys.
# Example: postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# The transaction pooler (port 6543) works for the engine but not for Prisma migrations.
DATABASE_URL=
# Create the bot's missing tables at start-up (never alters or drops anything; other tables untouched)
DB_AUTO_CREATE_TABLES=true
# Only needed if you use the bundled `db` service (docker compose --profile local-db); not for Supabase
POSTGRES_PASSWORD=

# --- Dashboard login (REQUIRED; the API stays locked until a password is set) ------------
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=
# Second password for the Config page (credentials, API keys, risk limits). The page stays
# locked until this is set; entering it unlocks the page for 15 minutes.
CONFIG_PASSWORD=

# --- Mode & safety (kept on the server on purpose) -----------------------------------------
# demo = Capital.com demo API host (virtual funds, live prices).
TRADING_MODE=demo
# Live mode additionally requires this exact phrase AND the live credentials (Config page):
#   LIVE_TRADING_CONFIRM=I_UNDERSTAND_THIS_USES_REAL_MONEY
LIVE_TRADING_CONFIRM=

# --- Docker host ports (docker-compose.yml only; both bound to 127.0.0.1) ----------------
# API_HOST_PORT=8710
# DB_HOST_PORT=5442

LOG_LEVEL=INFO
