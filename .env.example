# =============================================================================
# Tradlysis configuration. Copy to .env and fill in. Never commit .env.
# Every variable below is optional except where marked REQUIRED.
# Check your setup at any time with:  python -m app.doctor   (or: docker compose run --rm engine python -m app.doctor)
# =============================================================================

# --- Mode & safety -----------------------------------------------------------
# demo = Capital.com demo API host (virtual funds, live prices). This is the V1 mode.
TRADING_MODE=demo
# Live mode additionally requires this exact phrase AND the CAPITAL_LIVE_* credentials:
#   LIVE_TRADING_CONFIRM=I_UNDERSTAND_THIS_USES_REAL_MONEY
LIVE_TRADING_CONFIRM=
# Master switch read at start-up. The runtime kill switch is on the dashboard.
TRADING_ENABLED=true

# --- Capital.com (REQUIRED for the engine) ------------------------------------
# 1) Open a Capital.com account and its demo account; enable two-factor authentication
#    (Capital.com requires 2FA before it lets you create API keys).
# 2) Settings -> API integrations -> Generate API key. You choose a custom password for the key.
# The bot always connects to https://demo-api-capital.backend-capital.com in demo mode.
CAPITAL_DEMO_API_KEY=
# the e-mail (login) of your Capital.com account
CAPITAL_DEMO_IDENTIFIER=
# the custom password you set for the API key (not necessarily your login password)
CAPITAL_DEMO_API_PASSWORD=
# Optional: a specific demo account ID (python -m app.doctor prints the active one).
# Empty = the account that is active after login.
CAPITAL_DEMO_ACCOUNT_ID=
# Separate live credentials (not used in demo mode)
CAPITAL_LIVE_API_KEY=
CAPITAL_LIVE_IDENTIFIER=
CAPITAL_LIVE_API_PASSWORD=
CAPITAL_LIVE_ACCOUNT_ID=
# Capital.com market for INSTRUMENT (default: INSTRUMENT without "_", i.e. EURUSD)
CAPITAL_EPIC=

# --- Database (REQUIRED) --------------------------------------------------------
# Used by both Prisma (migrations) and the Python engine.
# Supabase: dashboard -> Connect -> "Session pooler" URI (port 5432), with your DB password filled in
# (URL-encode special characters, e.g. @ -> %40). Not the Supabase API URL/keys.
# Example: postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# The transaction pooler (port 6543) works for the engine but not for Prisma migrations.
DATABASE_URL=
# Create the bot's missing tables at start-up (never alters or drops anything; other tables untouched)
DB_AUTO_CREATE_TABLES=true
# Only needed if you use the bundled `db` service (docker compose --profile local-db); not for Supabase
POSTGRES_PASSWORD=

# --- Decision model via OpenRouter ---------------------------------------------------
OPENROUTER_API_KEY=
# TypeSafe's Jev decision model, called through OpenRouter's Decisions API (/api/alpha/decisions).
# A chat model id (e.g. openai/...) would use chat completions instead.
OPENROUTER_MODEL=typesafe/jev-1.13
# Model used to interpret central-bank news (defaults to OPENROUTER_MODEL)
OPENROUTER_NEWS_MODEL=
# candidates_only: call the model only when the deterministic trend-pullback rules find a
#                  candidate (cheap; every other interval is still logged as a WAIT).
# always:          call the model every 15 minutes (more data about the model, more cost).
LLM_CALL_POLICY=candidates_only
LLM_TIMEOUT_SECONDS=60

# --- Experiment ----------------------------------------------------------------
EXPERIMENT_NAME=v1-trend-pullback-eur-usd
INSTRUMENT=EUR_USD

# --- Risk engine (experiment parameters; the LLM can never change these) ---------------
# hard ceiling 1.0
RISK_PER_TRADE_PCT=0.25
# all open trades combined
MAX_TOTAL_RISK_PCT=0.5
# daily circuit breaker (trading day rolls at 17:00 New York)
MAX_DAILY_LOSS_PCT=1.0
# drawdown circuit breaker (manual reset)
MAX_DRAWDOWN_PCT=5.0
MAX_OPEN_TRADES=1
MIN_RISK_REWARD=2.0
MAX_SPREAD_PIPS=1.5
MIN_STOP_PIPS=5
MAX_STOP_PIPS=40
MAX_SLIPPAGE_PIPS=1.0
MIN_DECISION_CONFIDENCE=0.6
SIGNAL_COOLDOWN_MINUTES=60
STALE_PRICE_SECONDS=15
NEWS_BLACKOUT_BEFORE_MINUTES=30
NEWS_BLACKOUT_AFTER_MINUTES=30
NEWS_BLOCKING_IMPACTS=HIGH
NEWS_REQUIRE_FRESH_CALENDAR=true

# --- News sources (free, no key) ---------------------------------------------------
NEWS_CALENDAR_URL=https://nfs.faireconomy.media/ff_calendar_thisweek.json
NEWS_RSS_FEEDS=USD|https://www.federalreserve.gov/feeds/press_monetary.xml,EUR|https://www.ecb.europa.eu/rss/press.html

# --- Telegram alerts ------------------------------------------------------------
# 1) Message @BotFather -> /newbot -> copy the token
# 2) Send any message to your new bot, then open
#    https://api.telegram.org/bot<TOKEN>/getUpdates and copy "chat":{"id": ...}
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Dashboard / API (the API stays locked until a password is set) ---------------------
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=

# --- Docker host ports (docker-compose.yml only; both bound to 127.0.0.1) ----------------
# API_HOST_PORT=8710
# DB_HOST_PORT=5442

LOG_LEVEL=INFO
